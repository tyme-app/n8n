{
    "name": "n8n-nodes-tyme",
    "version": "1.0.2",
    "description": "n8n community node for Tyme – time tracking integration supporting time entries, absences, projects, tasks, and more.",
    "license": "MIT",
    "homepage": "https://tyme-app.com",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "Lars Gerckens",
        "email": "hello@numberfive.co"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tyme-app/n8n.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/TymeOAuth2Api.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Tyme/Tyme.node.js",
            "dist/nodes/Tyme/TymeTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    },
    "publishConfig": {
        "access": "public"
    }
}
